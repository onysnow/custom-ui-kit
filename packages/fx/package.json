{
  "name": "@onysnow/fx",
  "version": "0.1.0",
  "description": "WebGL light, glass, water and camera effects with one shared engine, scene graph and tuning registry",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onysnow/custom-ui-kit.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests"
  },
  "exports": {
    "./package.json": "./package.json",
    "./styles/effects.css": "./dist/styles/effects.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@onysnow/utils": "workspace:^",
    "html-to-image": "^1.11.13",
    "framer-motion": "^13.4.0"
  },
  "peerDependencies": {
    "@dimforge/rapier2d-compat": "0.21.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier2d-compat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dimforge/rapier2d-compat": "0.21.0",
    "@types/node": "^22.16.5"
  }
}
